# ---------------------------------------------------------------------------
# Karen OS ISO package list - INSTALLER ONLY (no live desktop).
# Boots straight into the macOS-style installer GUI. Target system gets the
# full desktop via karen-setup.sh during install.
# ---------------------------------------------------------------------------

# --- base system ---
base
linux
linux-firmware
mkinitcpio
arch-install-scripts
bash-completion

# --- network (installer + chroot setup need internet) ---
networkmanager
curl
wget
syslinux

# --- display (installer GUI) ---
xorg-server
xorg-xinit
xorg-xrandr
xorg-xdpyinfo
xf86-video-vesa
openbox
xterm

# --- installer runtime ---
python
python-pip
python-pyqt6
archinstall
git

# --- live boot (initramfs archiso hooks; REQUIRED - without these the
# emergency-shell 'Failed to mount "" on real root' happens at boot) ---
archiso
mkinitcpio-archiso

# --- boot splash + installer background ---
plymouth
hsetroot

# --- tools ---
sudo
